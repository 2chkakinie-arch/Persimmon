/* ============ search results ============ */
.results { max-width: 1100px; padding: 16px 24px; }
.result-card { display: flex; gap: 16px; margin-bottom: 20px; cursor: pointer; }
.result-card .vthumb { width: 360px; max-width: 40vw; flex: none; }
.result-card .r-ava { width: 24px; height: 24px; border-radius: 50%; }
.result-card .vtitle { font-size: 18px; font-weight: 400; }
.result-sub { font-size: 12px; color: var(--text-2); margin: 4px 0 10px; }
.result-ch { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-2); margin-bottom: 10px; }
.result-desc { font-size: 12px; color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.result-channel-row { display: flex; gap: 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border); }

/* ============ channel page ============ */
.ch-banner { height: 210px; margin: 16px 24px 0; border-radius: 16px; overflow: hidden; background: var(--skeleton); }
.ch-banner img { width: 100%; height: 100%; object-fit: cover; }
.ch-head { display: flex; gap: 24px; padding: 24px; align-items: center; }
.ch-head .big-ava { width: 160px; height: 160px; border-radius: 50%; overflow: hidden; background: var(--skeleton); flex: none; }
.ch-head .big-ava img { width: 100%; height: 100%; }
.ch-title { font-size: 36px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
.ch-meta { color: var(--text-2); font-size: 14px; margin: 6px 0; }
.ch-meta .handle { color: var(--text); font-weight: 500; }
.ch-desc { font-size: 14px; color: var(--text-2); max-width: 720px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
.ch-tabs { display: flex; gap: 24px; padding: 0 24px; border-bottom: 1px solid var(--border); position: sticky; top: 56px; background: var(--bg); z-index: 50; }
.ch-tab { padding: 14px 0; font-size: 15px; color: var(--text-2); position: relative; }
.ch-tab.active { color: var(--text); font-weight: 500; }
.ch-tab.active::after { content: ""; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--text); border-radius: 2px 2px 0 0; }
.verified { width: 14px; height: 14px; fill: var(--text-2); flex: none; }

/* playlist overlay badge (search rows / grid cards) */
.pl-strip {
  position: absolute; right: 4px; bottom: 4px; display: flex; align-items: center; gap: 5px;
  background: rgba(0,0,0,.8); color: #fff; font-size: 12px; font-weight: 500;
  padding: 2px 6px; border-radius: 4px; letter-spacing: .2px;
}
.pl-strip .ic { width: 14px; height: 14px; fill: #fff; }
.pl-kind { font-size: 12px; color: var(--text-2); margin: 2px 0 4px; }

/* ============ YouTube-style playlist panel on watch page ============ */
.plp { background: var(--chip-bg); border-radius: 14px; margin-bottom: 12px; overflow: hidden; }
.plp-head { padding: 10px 14px 8px; }
.plp-t1 { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; }
.plp-ic .ic { width: 20px; height: 20px; fill: var(--text); }
.plp-ic { display: flex; }
.plp-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.plp-spacer { flex: none; }
.plp-btn { width: 34px; height: 34px; }
.plp-btn .ic { width: 20px; height: 20px; fill: var(--text); }
.plp-btn.on { color: var(--blue); }
.plp-btn.on .ic { fill: var(--blue); }
.plp-sub { font-size: 12px; color: var(--text-2); margin-top: 2px; }
.plp-items { max-height: 480px; overflow-y: auto; scrollbar-width: thin; padding: 0 6px 6px; }
.plp.folded .plp-items { display: none; }
.plp-item { display: flex; gap: 8px; padding: 6px; border-radius: 10px; cursor: pointer; align-items: center; }
.plp-item:hover { background: var(--hover); }
.plp-item.active { background: var(--hover); }
.plp-item.active { }
.plp-item .plp-idx { width: 20px; flex: none; text-align: center; font-size: 12px; color: var(--text-2); }
.plp-item.active .plp-idx { color: var(--text); }
.plp-item .vthumb { width: 96px; flex: none; border-radius: 8px; }
.plp-item .plp-tt { font-size: 13px; font-weight: 500; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
.plp-item.active .plp-tt { color: var(--text); }

/* playlist page */
.pl-page { display: grid; grid-template-columns: 360px minmax(0,1fr); gap: 24px; padding: 24px; max-width: 1400px; }
.pl-side { background: linear-gradient(160deg, #3b6ea5, #1d3a5f); border-radius: 20px; padding: 24px; color: #fff; position: sticky; top: 80px; align-self: start; }
.pl-side h1 { font-size: 24px; font-weight: 700; margin: 16px 0 8px; }
.pl-side .pl-meta { font-size: 13px; opacity: .9; line-height: 1.7; }
.pl-thumb { border-radius: 12px; overflow: hidden; aspect-ratio: 16/9; background: rgba(0,0,0,.3); }
.pl-thumb img { width: 100%; height: 100%; object-fit: cover; }
.pl-item { display: flex; gap: 12px; padding: 8px; border-radius: 12px; cursor: pointer; align-items: center; }
.pl-item:hover { background: var(--hover); }
.pl-item .idx { width: 20px; font-size: 12px; color: var(--text-2); flex: none; text-align: center; }
.pl-item .vthumb { width: 100px; flex: none; }
.pl-item .vtitle { font-size: 14px; }

/* empty state (screenshot-faithful) */
.empty-state {
  max-width: 860px; margin: 40px auto; background: var(--bg-elev); border-radius: 16px;
  box-shadow: var(--shadow); padding: 36px 24px; text-align: center;
}
.empty-state h1 { font-size: 22px; font-weight: 700; margin-bottom: 14px; }
.empty-state p { color: var(--text-2); font-size: 14px; }

/* error / info blocks */
.error-box { max-width: 560px; margin: 60px auto; text-align: center; color: var(--text-2); font-size: 14px; line-height: 2; }
.error-box .retry { margin-top: 16px; background: var(--blue); color: #fff; border-radius: 18px; padding: 0 20px; height: 36px; font-size: 14px; font-weight: 500; }

/* toast */
#toast {
  position: fixed; left: 24px; bottom: 24px; z-index: 999; background: var(--text); color: var(--bg);
  padding: 14px 20px; border-radius: 12px; font-size: 14px; box-shadow: var(--shadow);
  animation: toast-in .25s;
}
@keyframes toast-in { from { transform: translateY(12px); opacity: 0; } }

/* spinner for lazy sections */
.mini-spin { display: grid; place-items: center; padding: 32px; }
.mini-spin::after { content: ""; width: 28px; height: 28px; border-radius: 50%; border: 3px solid var(--border); border-top-color: var(--text-2); animation: rot .8s linear infinite; }
